     GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
 
+  // reverse Z clips depth to [0, 1], the near plane at 1, so that the floats of the depth buffer
+  // keep their precision toward the far plane; nearer is greater
+#ifndef GL_ES_VERSION_3_0
+  const bool clipControl = GLAD_GL_VERSION_4_5 || GLAD_GL_ARB_clip_control;
+#else
