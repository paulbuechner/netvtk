diff --git a/Rendering/Core/vtkRenderWindow.h b/Rendering/Core/vtkRenderWindow.h
index 9d4366f..6e80475 100644
--- a/Rendering/Core/vtkRenderWindow.h
+++ b/Rendering/Core/vtkRenderWindow.h
@@ -686,6 +686,26 @@ public:
   vtkBooleanMacro(UseSRGBColorSpace, bool);
   ///@}
 
+  ///@{
+  /**
+   * Set/Get whether depth runs from 1 at the near clipping plane to 0 at the far one, in
+   * floating point (reverse Z). A fixed-point depth buffer that runs from 0 to 1 resolves less and
+   * less toward the far plane, the more so the larger the ratio of the clipping range; reversed,
+   * floating-point depth resolves about the same share of any distance, so the near plane may come
+   * very close to the eye. The renderers' projections, depth clears and depth tests follow, and so
+   * do their conversions between display and world coordinates: a depth read from the window goes
+   * back to its world point as before. An OpenGL window needs OpenGL 4.5 or ARB_clip_control, and
+   * turns it off with a warning without them; changing it makes the window's framebuffers again,
+   * their depth in floats, which a blit of it into another framebuffer needs there too. Mappers
+   * that compute their fragments' depth themselves (points as spheres, lines as tubes, the sphere
+   * and stick mappers) and the depth peeling, order independent translucency, SSAO and EDL passes
+   * assume the conventional depth. Default is off.
+   */
+  vtkGetMacro(UseReverseZ, bool);
+  vtkSetMacro(UseReverseZ, bool);
+  vtkBooleanMacro(UseReverseZ, bool);
+  ///@}
+
   enum : vtkTypeUInt16
   {
     PhysicalToWorldMatrixModified = vtkCommand::UserEvent + 200
@@ -856,6 +876,8 @@ private:
   void operator=(const vtkRenderWindow&) = delete;
 
   vtkNew<vtkStereoCompositor> StereoCompositor;
+
+  bool UseReverseZ = false;
 };
 
 VTK_ABI_NAMESPACE_END
