 Rendering/OpenGL2/vtkOpenGLCamera.h           |  3 ++
 .../OpenGL2/vtkOpenGLFramebufferObject.cxx    | 15 +++++--
 .../OpenGL2/vtkOpenGLFramebufferObject.h      |  5 ++-
 Rendering/OpenGL2/vtkOpenGLPolyDataMapper.cxx | 12 +++++-
 Rendering/OpenGL2/vtkOpenGLRenderWindow.cxx   | 39 +++++++++++++++++--
 Rendering/OpenGL2/vtkOpenGLRenderWindow.h     |  3 ++
 Rendering/OpenGL2/vtkOpenGLRenderer.cxx       |  4 +-
 Rendering/OpenGL2/vtkTextureObject.cxx        | 11 ++++--
 Rendering/OpenGL2/vtkTextureObject.h          |  5 ++-
 14 files changed, 135 insertions(+), 28 deletions(-)

