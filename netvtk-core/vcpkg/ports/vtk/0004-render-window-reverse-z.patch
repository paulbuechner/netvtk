diff --git a/Rendering/OpenGL2/vtkOpenGLCamera.cxx b/Rendering/OpenGL2/vtkOpenGLCamera.cxx
index cb3557c..6c4b737 100644
--- a/Rendering/OpenGL2/vtkOpenGLCamera.cxx
