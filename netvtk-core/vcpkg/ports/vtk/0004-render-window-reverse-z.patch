+#ifndef GL_ES_VERSION_3_0
+  if (clipControl)
+  {
+    glClipControl(GL_LOWER_LEFT, this->GetUseReverseZ() ? GL_ZERO_TO_ONE : GL_NEGATIVE_ONE_TO_ONE);
+  }
+#endif
+  this->GetState()->vtkglDepthFunc(this->GetUseReverseZ() ? GL_GEQUAL : GL_LEQUAL);
