<Project>

  <!-- the packed NetVtk: netvtk-core's build.py pack writes its version here, next to the packages nuget.config reads -->
  <Import Project="$(MSBuildThisFileDirectory)..\netvtk-core\artifacts\packages\NetVtk.version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\netvtk-core\artifacts\packages\NetVtk.version.props')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Authors>Paul Büchner</Authors>
    <Copyright>Copyright (c) 2026 Paul Büchner</Copyright>
  </PropertyGroup>

</Project>
