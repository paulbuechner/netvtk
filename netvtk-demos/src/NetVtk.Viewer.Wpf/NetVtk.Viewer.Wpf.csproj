<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The WPF viewer: VtkViewer in an HwndHost, simulation results with a field, a scalar bar, a cut plane, contours and a warp.</Description>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NetVtk.Viewer.Wpf</RootNamespace>
    <AssemblyName>NetVtk.Viewer.Wpf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetVtk.Viewer\NetVtk.Viewer.csproj" />
  </ItemGroup>

</Project>
