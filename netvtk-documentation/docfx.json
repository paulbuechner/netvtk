{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/**/*.md",
          "articles/**/toc.yml",
          "classes/**/*.md",
          "classes/**/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "assets/*.svg"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appTitle": "NetVtk",
      "_appName": "NetVtk",
      "_appFooter": "NetVtk is MIT licensed. The Visualization Toolkit (VTK) is BSD-3-Clause.",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
