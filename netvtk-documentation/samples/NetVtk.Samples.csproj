<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The documentation's examples: the articles include their regions ([!code-csharp[](...#region)]), and running them as
    tests checks they do what the articles say. On the packed NetVtk, like an app: netvtk-core's build.py pack writes the
    version to NetVtk.version.props, nuget.config reads the packages next to it.
  -->
  <Import Project="..\..\netvtk-core\artifacts\packages\NetVtk.version.props" Condition="Exists('..\..\netvtk-core\artifacts\packages\NetVtk.version.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NetVtk.Samples</RootNamespace>
    <Authors>Paul Büchner</Authors>
    <Copyright>Copyright (c) 2026 Paul Büchner</Copyright>
    <!-- Programs/*.cs are whole programs, each with its Main: no entry point from the test SDK besides them, and
         Contours' is the test host's (a test project on .NET is an executable) -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>Contours.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetVtk" Version="$(NetVtkPackageVersion)" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>

  <!-- Interop.cs: the restored package's folder, where its swig/ folder is -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NetVtkPackage</_Parameter1>
      <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))netvtk/$(NetVtkPackageVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Readmes.cs: the READMEs' examples must stay the tested samples -->
  <ItemGroup>
    <None Include="..\..\README.md" Link="Readmes\Repository.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\netvtk-core\src\NetVtk\README.md" Link="Readmes\Package.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="GettingStarted.cs" Link="Readmes\GettingStarted.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="Programs\Contours.cs" Link="Readmes\Contours.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- before restore reads the package references (each project, a solution restore too), and before a build -->
  <Target Name="NetVtkRequirePackage" BeforeTargets="CollectPackageReferences;Build">
    <Error Condition="'$(NetVtkPackageVersion)' == ''" Text="No packed NetVtk: run 'python build.py pack --rids win-x64,win-x86' in netvtk-core first." />
  </Target>

</Project>
